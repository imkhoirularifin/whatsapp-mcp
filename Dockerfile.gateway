FROM caddy:2.11.7-alpine
# Non-root Caddy; XDG_* into /tmp so read_only + tmpfs compose mounts work.
ENV XDG_CONFIG_HOME=/tmp/caddy-config \
    XDG_DATA_HOME=/tmp/caddy-data
COPY Caddyfile /etc/caddy/Caddyfile
COPY gateway-entrypoint.sh /usr/local/bin/gateway-entrypoint.sh
RUN chmod 755 /usr/local/bin/gateway-entrypoint.sh
# Drop cap_net_bind_service from the caddy binary so exec works under
# compose cap_drop: ALL + no-new-privileges (otherwise: Operation not permitted).
RUN apk add --no-cache libcap && setcap -r /usr/bin/caddy && apk del libcap
USER 65532:65532
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/gateway-entrypoint.sh"]
